    "openai",
    "openai-compatible",
    "llm",
    "llm-gateway",
    "llm-proxy",
    "rapidapi",
    "aider",
    "cline",
    "continue",
    "model-routing",
    "gpt",
    "claude",
    "gemini",
    "modelis"
  ],
